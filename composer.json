{
    "name": "alennikolic/dcinfrasnap",
    "description": "Snapshots of data centre infrastructure: inventory collection, history and change journal.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-sodium": "*",
        "ext-curl": "*",
        "ext-pcntl": "*"
    },
    "autoload": {
        "psr-4": {
            "DcInfraSnap\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
