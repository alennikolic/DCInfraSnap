#!/usr/bin/env php
<?php
// bin/dcinfrasnap
//
// The only CLI entry point.
//
// Usage:
//   bin/dcinfrasnap help                 show this list
//   bin/dcinfrasnap migrate              apply any migrations not yet applied
//   bin/dcinfrasnap migrate:status       show migration state, change nothing
//   bin/dcinfrasnap key:generate         generate a value for SECRET_KEY
//   bin/dcinfrasnap password:hash        generate APP_PASSWORD_HASH for the GUI
//   bin/dcinfrasnap lang:check           compare language files against English
//   bin/dcinfrasnap integrations         list the configured sources
//   bin/dcinfrasnap integration:add      add a vCenter (interactive)
//   bin/dcinfrasnap integration:test <id>      check the connection
//   bin/dcinfrasnap integration:password <id>  change the password
//   bin/dcinfrasnap integration:enable <id>
//   bin/dcinfrasnap integration:disable <id>
//   bin/dcinfrasnap integration:delete <id>    remove it and everything collected
//   bin/dcinfrasnap collect:dry <id>     collect and report, write nothing
//   bin/dcinfrasnap discover <id>        collect and store, now
//   bin/dcinfrasnap discover:queue <id>  put on the queue for the worker
//   bin/dcinfrasnap discover:queue --all queue every active source
//   bin/dcinfrasnap runs                 recent collections
//   bin/dcinfrasnap runs:reset <run>     release a stuck run
//   bin/dcinfrasnap worker               process the collection queue
//
// In Docker:
//   docker compose exec app php bin/dcinfrasnap <command>
//
// Why "php bin/dcinfrasnap" and not "bin/dcinfrasnap": the repository is
// bind-mounted, so the container sees the permissions of the host machine.
// If the file is not executable there, calling it directly gives "permission
// denied". Going through php always works.

declare(strict_types=1);

if (PHP_SAPI !== 'cli') {
    http_response_code(404);
    exit(1);
}

use DcInfraSnap\Core\Database;
use DcInfraSnap\Core\Migrator;
use DcInfraSnap\Core\Secret;
use DcInfraSnap\I18n\Translator;
use DcInfraSnap\Collector\Collector;
use DcInfraSnap\Integration\IntegrationRepository;
use DcInfraSnap\Inventory\InventoryRepository;
use DcInfraSnap\Inventory\RawObjectRepository;
use DcInfraSnap\Run\RunRepository;
use DcInfraSnap\Source\VCenter\ClientFactory;
use DcInfraSnap\Source\VCenter\VCenterException;

$config = require dirname(__DIR__) . '/config/bootstrap.php';

// -----------------------------------------------------------------------
// Small helpers
// -----------------------------------------------------------------------
$stdout = static function (string $line = ''): void {
    fwrite(STDOUT, $line . PHP_EOL);
};

$stderr = static function (string $line = ''): void {
    fwrite(STDERR, $line . PHP_EOL);
};

/** Read one line from the terminal. */
$ask = static function (string $question, string $default = ''): string {
    $suffix = $default === '' ? '' : " [{$default}]";

    fwrite(STDOUT, $question . $suffix . ': ');

    $answer = fgets(STDIN);
    $answer = $answer === false ? '' : trim($answer);

    return $answer === '' ? $default : $answer;
};

/** Read a line without echoing it back. Falls back to a visible prompt. */
$askSecret = static function (string $question) use ($stdout): string {
    fwrite(STDOUT, $question . ': ');

    // stty is present in the PHP Alpine image; if it is not, the password is
    // simply visible, which is better than refusing to run.
    $hasStty = @shell_exec('command -v stty 2>/dev/null') !== null;

    if ($hasStty) {
        @shell_exec('stty -echo 2>/dev/null');
    }

    $answer = fgets(STDIN);

    if ($hasStty) {
        @shell_exec('stty echo 2>/dev/null');
        $stdout('');
    }

    return $answer === false ? '' : trim($answer);
};

$command = $argv[1] ?? 'help';

// =======================================================================
// Commands that need neither the database nor a key
// =======================================================================

// --- help --------------------------------------------------------------
if (in_array($command, ['help', '--help', '-h'], true)) {
    $stdout($config['app_name'] . ' — command line');
    $stdout();
    $stdout('  migrate              apply any migrations not yet applied');
    $stdout('  migrate:status       show migration state, change nothing');
    $stdout('  key:generate         generate a value for SECRET_KEY');
    $stdout('  password:hash        generate APP_PASSWORD_HASH for the GUI');
    $stdout('  lang:check           compare language files against English');
    $stdout();
    $stdout('  integrations                list the configured sources');
    $stdout('  integration:add             add a vCenter (interactive)');
    $stdout('  integration:test <id>       check the connection');
    $stdout('  integration:password <id>   change the password');
    $stdout('  integration:enable <id>');
    $stdout('  integration:disable <id>');
    $stdout('  integration:delete <id>     remove it and everything collected');
    $stdout();
    $stdout('  collect:dry <id>            collect and report, write nothing');
    $stdout('  discover <id>               collect and store, now');
    $stdout('  discover:queue <id>         put on the queue for the worker');
    $stdout('  discover:queue --all        queue every active source');
    $stdout('  runs                        recent collections');
    $stdout('  runs:reset <run>            release a stuck run');
    $stdout('  worker                      process the collection queue');
    $stdout('  help                 this list');
    $stdout();
    $stdout('In Docker:  docker compose exec app php bin/dcinfrasnap <command>');
    exit(0);
}

// --- key:generate --------------------------------------------------------
if ($command === 'key:generate') {
    $stdout('Put this in .env as SECRET_KEY:');
    $stdout();
    $stdout('SECRET_KEY=' . Secret::generateKey());
    $stdout();
    $stdout('If this key is lost or changed, every stored credential becomes');
    $stdout('undecryptable and has to be entered again.');
    exit(0);
}

// --- password:hash -------------------------------------------------------
if ($command === 'password:hash') {
    $password = $askSecret('Password for the GUI');

    if (strlen($password) < 8) {
        $stderr('The password must be at least 8 characters.');
        exit(1);
    }

    $repeat = $askSecret('Repeat');

    if (!hash_equals($password, $repeat)) {
        $stderr('The two entries do not match.');
        exit(1);
    }

    $hash = password_hash($password, PASSWORD_BCRYPT);

    $stdout();
    $stdout('Put this in .env, SINGLE QUOTES INCLUDED:');
    $stdout();
    $stdout("APP_PASSWORD_HASH='" . $hash . "'");
    $stdout();
    $stdout('The quotes matter: the hash contains $, which Compose would');
    $stdout('otherwise read as a variable and swallow part of the string.');
    exit(0);
}

// --- lang:check ----------------------------------------------------------
// Compares every language file against English and reports what is missing
// and what is left over. Translating is a slow job done in pieces, and this
// is how you see where it stands.
if ($command === 'lang:check') {
    $dir       = $config['lang_dir'];
    $available = Translator::available($dir);

    /** @var array<string, string> $english */
    $english = require $dir . '/en.php';
    $keys    = array_keys($english);

    $stdout('Reference: en.php — keys: ' . count($keys));
    $stdout();

    foreach (Translator::PLANNED as $code) {
        if ($code === 'en') {
            continue;
        }

        if (!isset($available[$code])) {
            $stdout(sprintf('  %-4s  not started (no lang/%s.php)', $code, $code));
            continue;
        }

        /** @var array<string, string> $messages */
        $messages = require $dir . '/' . $code . '.php';

        $missing = array_diff($keys, array_keys($messages));
        $extra   = array_diff(array_keys($messages), $keys);

        $stdout(sprintf(
            '  %-4s  %s — translated: %d/%d, missing: %d, no longer used: %d',
            $code,
            $available[$code],
            count($keys) - count($missing),
            count($keys),
            count($missing),
            count($extra)
        ));

        foreach ($missing as $key) {
            $stdout('          missing: ' . $key);
        }

        foreach ($extra as $key) {
            $stdout('          unused:  ' . $key);
        }
    }

    $stdout();
    $stdout('A missing key is not an error — it falls back to English.');
    exit(0);
}

// =======================================================================
// Commands that need the database
// =======================================================================
try {
    $pdo = Database::connect($config['db']);
} catch (Throwable $e) {
    $stderr($e->getMessage());
    $stderr();
    $stderr('Is the database up?  docker compose ps');
    exit(1);
}

$migrator = new Migrator($pdo, $config['migrations_dir']);
$migrator->ensureTable();

// --- migrate:status ------------------------------------------------------
if ($command === 'migrate:status') {
    $available = $migrator->available();
    $applied   = $migrator->applied();
    $drift     = $migrator->drift();

    if ($available === []) {
        $stdout('No migration files in ' . $config['migrations_dir']);
        exit(0);
    }

    $stdout(sprintf('%-8s %-28s %-9s %s', 'VERSION', 'NAME', 'STATE', 'APPLIED AT'));
    $stdout(str_repeat('-', 72));

    foreach ($available as $version => $migration) {
        $isApplied = isset($applied[$version]);

        $stdout(sprintf(
            '%-8s %-28s %-9s %s',
            $version,
            $migration['name'],
            $isApplied ? 'applied' : 'pending',
            $isApplied ? $applied[$version]['applied_at'] . ' UTC' : '—'
        ));
    }

    $stdout();

    if ($drift !== []) {
        $stderr('WARNING: these migrations have been edited after being applied:');

        foreach ($drift as $d) {
            $stderr('  ' . $d['version'] . '  ' . $d['name']);
        }

        $stderr();
        $stderr('The file and the database no longer agree. A fix belongs in a new');
        $stderr('migration, not in one that has already run.');
        exit(2);
    }

    exit(0);
}

// --- migrate -------------------------------------------------------------
if ($command === 'migrate') {
    $drift = $migrator->drift();

    if ($drift !== []) {
        $stderr('Refusing to run: these migrations have been edited after being applied:');

        foreach ($drift as $d) {
            $stderr('  ' . $d['version'] . '  ' . $d['name']);
        }

        $stderr();
        $stderr('Put the file back the way it was, or add the change as a new migration.');
        exit(2);
    }

    $applied = $migrator->applied();
    $pending = $migrator->pending();

    if ($pending === []) {
        $stdout('Nothing to apply. The database is up to date (' . count($applied) . ' applied).');
        exit(0);
    }

    $stdout('Applying ' . count($pending) . ' migration(s)...');
    $stdout();

    foreach ($pending as $migration) {
        $label = sprintf('  %s  %s', $migration['version'], $migration['name']);

        try {
            $durationMs = $migrator->apply($migration);
            $stdout($label . str_repeat(' ', max(1, 40 - strlen($label))) . "OK ({$durationMs} ms)");
        } catch (Throwable $e) {
            $stdout($label . str_repeat(' ', max(1, 40 - strlen($label))) . 'FAILED');
            $stderr();
            $stderr('Migration ' . $migration['version'] . ' failed:');
            $stderr('  ' . $e->getMessage());
            $stderr();
            $stderr('NOTE: MySQL does not roll back DDL. If this file held several');
            $stderr('statements, some may already be applied. On a fresh install the');
            $stderr('simplest fix is: docker compose down -v && docker compose up -d');

            exit(1);
        }
    }

    $stdout();
    $stdout('Done. Applied in total: ' . (count($applied) + count($pending)) . '.');
    exit(0);
}

// =======================================================================
// Sources
//
// Everything from here on needs the encryption key as well.
// =======================================================================
if (str_starts_with($command, 'integration')) {
    try {
        $secret = new Secret($config['secret_key']);
    } catch (Throwable $e) {
        $stderr($e->getMessage());
        exit(1);
    }

    $repo = new IntegrationRepository($pdo, $secret);

    /** The source named by the first argument, or exit with a message. */
    $requireIntegration = static function () use ($argv, $repo, $stderr) {
        $id = isset($argv[2]) ? (int) $argv[2] : 0;

        if ($id < 1) {
            $stderr('Which source? Give its number, e.g. integration:test 1');
            $stderr('List them with: integrations');
            exit(1);
        }

        $integration = $repo->find($id);

        if ($integration === null) {
            $stderr("There is no source with number {$id}.");
            exit(1);
        }

        return $integration;
    };

    // --- integration:add -------------------------------------------------
    if ($command === 'integration:add') {
        $stdout('New vCenter source.');
        $stdout();

        $hostname = $ask('Hostname or IP of the vCenter');

        if ($hostname === '') {
            $stderr('The address is required.');
            exit(1);
        }

        if (preg_match('#^https?://#i', $hostname) === 1) {
            $stderr('Enter the hostname only, without https://');
            exit(1);
        }

        $name     = $ask('Name for this source', $hostname);
        $port     = (int) $ask('Port', '443');
        $username = $ask('Username (a read-only account is enough)');

        if ($username === '') {
            $stderr('The username is required.');
            exit(1);
        }

        $password = $askSecret('Password');

        if ($password === '') {
            $stderr('The password is required.');
            exit(1);
        }

        $verify = strtolower($ask('Verify the TLS certificate? (y/N)', 'n')) === 'y';

        try {
            $newId = $repo->create(
                name: $name,
                hostname: $hostname,
                username: $username,
                password: $password,
                port: $port,
                verifyPeer: $verify,
            );
        } catch (Throwable $e) {
            $stderr($e->getMessage());
            exit(1);
        }

        $stdout();
        $stdout("Added as number {$newId}.");
        $stdout("Check it with: php bin/dcinfrasnap integration:test {$newId}");
        exit(0);
    }

    // --- integrations ----------------------------------------------------
    if ($command === 'integrations') {
        $integrations = $repo->all();

        if ($integrations === []) {
            $stdout('No sources yet. Add the first with: bin/dcinfrasnap integration:add');
            exit(0);
        }

        $stdout(sprintf(
            '%-4s %-22s %-30s %-10s %-10s %s',
            'ID', 'NAME', 'ADDRESS', 'STATE', 'VERSION', 'LAST TEST'
        ));
        $stdout(str_repeat('-', 104));

        foreach ($integrations as $i) {
            $test = $i->lastTestedAt === null
                ? 'not tested'
                : ($i->lastTestOk ? 'OK ' : 'FAILED ') . $i->lastTestedAt;

            $stdout(sprintf(
                '%-4d %-22s %-30s %-10s %-10s %s',
                $i->id,
                mb_strimwidth($i->name, 0, 22, '..'),
                mb_strimwidth($i->endpoint(), 0, 30, '..'),
                $i->isActive ? 'active' : 'disabled',
                $i->productVersion ?? '—',
                $test
            ));
        }

        $stdout();
        exit(0);
    }

    // --- integration:test ------------------------------------------------
    if ($command === 'integration:test') {
        $integration = $requireIntegration();

        $stdout("Connecting to {$integration->endpoint()} as {$integration->username} ...");

        $factory = new ClientFactory(timeout: 30);

        try {
            $client = $factory->make($integration, $repo->password($integration->id));
            $result = $client->testConnection();

            $message = 'connected to ' . ($result['full_name'] ?? $result['version'] ?? '?');

            $repo->recordTest($integration->id, true, $message, $result['version']);

            $stdout();
            $stdout('OK — ' . $message);
            $stdout('  product version : ' . ($result['version'] ?? '—'));
            $stdout('  API version     : ' . ($result['api_version'] ?? '—'));
            $stdout('  SOAP calls      : ' . $client->callCount());
            exit(0);
        } catch (VCenterException $e) {
            $repo->recordTest($integration->id, false, $e->getMessage());

            $stderr();
            $stderr('FAILED: ' . $e->getMessage());
            exit(1);
        } catch (Throwable $e) {
            $repo->recordTest($integration->id, false, $e->getMessage());

            $stderr();
            $stderr('FAILED: ' . $e->getMessage());
            exit(1);
        }
    }

    // --- integration:password --------------------------------------------
    if ($command === 'integration:password') {
        $integration = $requireIntegration();

        $stdout("New password for {$integration->username} @ {$integration->endpoint()}");

        $password = $askSecret('Password');

        if ($password === '') {
            $stderr('The password is required.');
            exit(1);
        }

        if (!hash_equals($password, $askSecret('Repeat'))) {
            $stderr('The two entries do not match.');
            exit(1);
        }

        $repo->updatePassword($integration->id, $password);

        $stdout();
        $stdout('Saved. Check it with: php bin/dcinfrasnap integration:test ' . $integration->id);
        exit(0);
    }

    // --- integration:enable / integration:disable -------------------------
    if ($command === 'integration:enable' || $command === 'integration:disable') {
        $integration = $requireIntegration();
        $enable      = $command === 'integration:enable';

        $repo->setActive($integration->id, $enable);

        $stdout($integration->name . ' is now ' . ($enable ? 'active' : 'disabled') . '.');
        exit(0);
    }

    // --- integration:delete -----------------------------------------------
    if ($command === 'integration:delete') {
        $integration = $requireIntegration();
        $counts      = $repo->collectedCounts($integration->id);
        $total       = array_sum($counts);

        $stdout("About to delete: {$integration->name} ({$integration->endpoint()})");

        if ($total > 0) {
            $stdout();
            $stdout('This also deletes everything collected through it:');

            foreach ($counts as $table => $count) {
                if ($count > 0) {
                    $stdout(sprintf('  %-16s %d', $table, $count));
                }
            }
        }

        $stdout();

        if (strtolower($ask('Type "yes" to confirm')) !== 'yes') {
            $stdout('Cancelled. Nothing was deleted.');
            exit(0);
        }

        try {
            $repo->delete($integration->id);
        } catch (Throwable $e) {
            $stderr('Delete failed: ' . $e->getMessage());
            exit(1);
        }

        $stdout('Deleted.');
        exit(0);
    }

    $stderr('Unknown command: ' . $command);
    $stderr('Try: php bin/dcinfrasnap help');
    exit(1);
}

// =======================================================================
// Collecting
// =======================================================================
if (in_array($command, ['discover', 'discover:queue', 'collect:dry', 'runs', 'runs:reset', 'worker'], true)) {
    try {
        $secret = new Secret($config['secret_key']);
    } catch (Throwable $e) {
        $stderr($e->getMessage());
        exit(1);
    }

    $integrations = new IntegrationRepository($pdo, $secret);
    $runs         = new RunRepository($pdo);

    $makeCollector = static fn (?callable $reporter = null): Collector => new Collector(
        $integrations,
        $runs,
        new InventoryRepository($pdo),
        new RawObjectRepository($pdo),
        new ClientFactory(timeout: 300),
        $reporter,
    );

    /** The source named by the first argument. */
    $requireSource = static function () use ($argv, $integrations, $stderr) {
        $id = isset($argv[2]) ? (int) $argv[2] : 0;

        if ($id < 1) {
            $stderr('Which source? Give its number, e.g. discover 1');
            $stderr('List them with: integrations');
            exit(1);
        }

        $integration = $integrations->find($id);

        if ($integration === null) {
            $stderr("There is no source with number {$id}.");
            exit(1);
        }

        return $integration;
    };

    // --- runs ------------------------------------------------------------
    if ($command === 'runs') {
        $recent = $runs->recent(25);

        if ($recent === []) {
            $stdout('No collections yet. Start one with: bin/dcinfrasnap discover 1');
            exit(0);
        }

        $stdout(sprintf(
            '%-5s %-20s %-9s %-19s %7s %7s %7s %7s %7s %6s',
            'RUN', 'SOURCE', 'STATUS', 'QUEUED (UTC)',
            'CLUSTER', 'HOST', 'VM', 'DSTORE', 'LIC', 'CALLS'
        ));
        $stdout(str_repeat('-', 118));

        foreach ($recent as $run) {
            $stdout(sprintf(
                '%-5d %-20s %-9s %-19s %7s %7s %7s %7s %7s %6d',
                $run['id'],
                mb_strimwidth((string) $run['integration_name'], 0, 20, '..'),
                $run['status'],
                (string) $run['queued_at'],
                $run['clusters_status'] === 'ok' ? $run['clusters_found'] : strtoupper((string) $run['clusters_status']),
                $run['hosts_status'] === 'ok' ? $run['hosts_found'] : strtoupper((string) $run['hosts_status']),
                $run['vms_status'] === 'ok' ? $run['vms_found'] : strtoupper((string) $run['vms_status']),
                $run['datastores_status'] === 'ok' ? $run['datastores_found'] : strtoupper((string) $run['datastores_status']),
                $run['licenses_status'] === 'ok' ? $run['licenses_found'] : strtoupper((string) $run['licenses_status']),
                $run['api_calls']
            ));

            if ($run['error_message'] !== null) {
                $stdout('      ' . mb_strimwidth((string) $run['error_message'], 0, 110, '..'));
            }
        }

        $stdout();
        exit(0);
    }

    // --- runs:reset -------------------------------------------------------
    if ($command === 'runs:reset') {
        $runId = isset($argv[2]) ? (int) $argv[2] : 0;

        if ($runId < 1) {
            $stderr('Which run? Give its number, e.g. runs:reset 7');
            exit(1);
        }

        if ($runs->reset($runId)) {
            $stdout("Run {$runId} released. The source is no longer locked.");
            exit(0);
        }

        $stderr("Run {$runId} is not queued or running; nothing to release.");
        exit(1);
    }

    // --- collect:dry ------------------------------------------------------
    //
    // Fetch everything and report it, writing nothing. Useful before the
    // first real collection: it shows what the account can actually see.
    if ($command === 'collect:dry') {
        $integration = $requireSource();

        $collector = $makeCollector($stdout);
        $result    = $collector->run($integration, 0, dryRun: true);

        $stdout();
        $stdout('Nothing was written. SOAP calls: ' . $result['api_calls']);

        exit($result['status'] === 'failed' ? 1 : 0);
    }

    // --- discover ---------------------------------------------------------
    if ($command === 'discover') {
        $integration = $requireSource();

        try {
            $runId = $runs->startDirect($integration->id, 'cli');
        } catch (Throwable $e) {
            $stderr($e->getMessage());
            $stderr('Release a stuck run with: runs:reset <number>');
            exit(1);
        }

        $stdout("Run {$runId} for {$integration->name}.");

        $result = $makeCollector($stdout)->run($integration, $runId);

        $stdout();
        $stdout(sprintf(
            'Finished: %s. SOAP calls: %d.',
            strtoupper($result['status']),
            $result['api_calls']
        ));

        exit($result['status'] === 'failed' ? 1 : 0);
    }

    // --- discover:queue ---------------------------------------------------
    if ($command === 'discover:queue') {
        $all = ($argv[2] ?? '') === '--all';

        $targets = $all
            ? $integrations->all(onlyActive: true)
            : [$requireSource()];

        if ($targets === []) {
            $stdout('No active sources to queue.');
            exit(0);
        }

        $queued = 0;

        foreach ($targets as $integration) {
            try {
                $runId = $runs->queue($integration->id, $all ? 'schedule' : 'cli');
                $stdout("Queued run {$runId} for {$integration->name}.");
                $queued++;
            } catch (Throwable $e) {
                // With --all this is routine: one source still collecting
                // should not stop the others being queued.
                $stdout("Skipped {$integration->name}: " . $e->getMessage());
            }
        }

        $stdout();
        $stdout("Queued: {$queued}. The worker picks them up within 5 seconds.");
        exit(0);
    }

    // --- worker -----------------------------------------------------------
    //
    // Takes queued runs and carries them out.
    if ($command === 'worker') {
        $running = true;

        if (function_exists('pcntl_async_signals')) {
            pcntl_async_signals(true);

            // Finish what is in hand, then exit. Without this, docker compose
            // stop/restart kills a run halfway and leaves it locked until the
            // stale timeout expires.
            $stop = static function () use (&$running, $stdout): void {
                $stdout('Signal received; stopping after the current job.');
                $running = false;
            };

            pcntl_signal(SIGTERM, $stop);
            pcntl_signal(SIGINT, $stop);
        }

        $stdout($config['app_name'] . ' worker started. Polling every 5 s.');

        while ($running) {
            // Runs whose worker died stay 'running' and keep their source
            // locked. Releasing them is part of every pass, not a separate
            // chore somebody has to remember.
            $released = $runs->releaseStale();

            if ($released > 0) {
                $stdout("Released {$released} run(s) with no sign of life.");
            }

            $claimed = null;

            try {
                $claimed = $runs->claimNext();
            } catch (Throwable $e) {
                $stderr('Cannot read the queue: ' . $e->getMessage());
            }

            if ($claimed === null) {
                sleep(5);
                continue;
            }

            $runId       = (int) $claimed['id'];
            $integration = $integrations->find((int) $claimed['integration_id']);

            if ($integration === null) {
                $runs->finish($runId, 'failed', 0, 'The source was deleted before the run started.');
                continue;
            }

            $stdout("Run {$runId}: {$integration->name}");

            try {
                $result = $makeCollector($stdout)->run($integration, $runId);

                $stdout(sprintf(
                    "Run {$runId} finished: %s, %d SOAP calls.",
                    strtoupper($result['status']),
                    $result['api_calls']
                ));
            } catch (Throwable $e) {
                // The collector handles its own failures; anything reaching
                // here is unexpected, and the run must not be left running.
                $runs->finish($runId, 'failed', 0, $e->getMessage());
                $stderr("Run {$runId} failed unexpectedly: " . $e->getMessage());
            }
        }

        $stdout('Worker stopped.');
        exit(0);
    }
}

// --- unknown -------------------------------------------------------------
$stderr('Unknown command: ' . $command);
$stderr('Try: php bin/dcinfrasnap help');
exit(1);
