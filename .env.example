# .env.example
#
# Copy to .env and edit. The .env file is NOT in the repository.
#
#   cp .env.example .env

# --- Application ------------------------------------------------------
# dev or prod. In prod, also change display_errors and
# opcache.validate_timestamps in docker/php/php.ini.
APP_ENV=dev

# Default interface language. Falls back to English for any string the
# chosen language has not translated yet.
# Available: en   (de, sr, ru are prepared but not translated yet)
APP_LOCALE=en

# Port the GUI listens on, on the host machine.
WEB_PORT=8080

# --- Login ------------------------------------------------------------
# bcrypt hash of the GUI password. Generate it with:
#   docker compose run --rm app php bin/dcinfrasnap password:hash
#
# THE SINGLE QUOTES ARE MANDATORY. A bcrypt hash contains $, which Compose
# would otherwise read as a variable reference and eat half the string.
#
# Leave empty to keep the GUI closed.
APP_PASSWORD_HASH=''

# --- Encryption -------------------------------------------------------
# 32 bytes, base64. Generate it with:
#   docker compose run --rm app php bin/dcinfrasnap key:generate
#
# vCenter passwords are encrypted with this key. If it is lost or changed,
# every stored credential becomes undecryptable and has to be entered again.
# That is the purpose of the key, not a flaw.
SECRET_KEY=

# --- Database ---------------------------------------------------------
DB_NAME=dcinfrasnap
DB_USER=dcinfrasnap
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Port MySQL is published on, on the host machine. For development tools
# only — in production, delete the "ports" block of the db service in
# docker-compose.yml.
DB_PORT_HOST=3307
